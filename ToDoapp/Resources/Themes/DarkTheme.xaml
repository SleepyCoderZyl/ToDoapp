<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme color palette -->
    <Color x:Key="PrimaryColor">#FF6B47</Color>
    <Color x:Key="PrimaryLightColor">#FF825F</Color>
    <Color x:Key="PrimaryDarkColor">#E85A36</Color>
    <Color x:Key="AccentColor">#FFB199</Color>
    <Color x:Key="SuccessColor">#5EC269</Color>
    <Color x:Key="DangerColor">#F85149</Color>
    <Color x:Key="WarningColor">#F2B84B</Color>

    <Color x:Key="BackgroundDark">#202020</Color>
    <Color x:Key="BackgroundMedium">#2D2D2D</Color>
    <Color x:Key="BackgroundLight">#3D3D3D</Color>
    <Color x:Key="SurfaceColor">#1F1F1F</Color>
    <Color x:Key="SurfaceLight">#282828</Color>

    <Color x:Key="TextPrimary">#F5F5F5</Color>
    <Color x:Key="TextSecondary">#B8B8B8</Color>
    <Color x:Key="TextMuted">#7A7A7A</Color>

    <!-- Brushes derived from the palette -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#33F85149"/>
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#33FF6B47"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF7168"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#E0443D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMedium}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#282828"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#282828"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#242424"/>
    <SolidColorBrush x:Key="InputBrush" Color="#242424"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#343434"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#333333"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="TagBrush" Color="#303030"/>
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#343434"/>
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#FF6B47"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#F5F5F5"/>

    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DialogForegroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DialogSecondaryForegroundBrush" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#1F1F1F"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
