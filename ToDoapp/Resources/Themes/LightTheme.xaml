<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme color palette -->
    <Color x:Key="PrimaryColor">#FF6B47</Color>
    <Color x:Key="PrimaryLightColor">#FF825F</Color>
    <Color x:Key="PrimaryDarkColor">#E85A36</Color>
    <Color x:Key="AccentColor">#FFB199</Color>
    <Color x:Key="SuccessColor">#2B9A46</Color>
    <Color x:Key="DangerColor">#D63B31</Color>
    <Color x:Key="WarningColor">#C47E23</Color>

    <Color x:Key="BackgroundDark">#F7F7F7</Color>
    <Color x:Key="BackgroundMedium">#F3F3F3</Color>
    <Color x:Key="BackgroundLight">#D0D0D0</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceLight">#F3F3F3</Color>

    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#525252</Color>
    <Color x:Key="TextMuted">#767676</Color>

    <!-- Brushes derived from the palette -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#20D63B31"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#E8554A"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#B83229"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMedium}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#767676"/>
    <SolidColorBrush x:Key="TagBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#FFEFE9"/>
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#FF6B47"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#B83D1F"/>

    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DialogForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DialogSecondaryForegroundBrush" Color="#525252"/>
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#DADADA"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
