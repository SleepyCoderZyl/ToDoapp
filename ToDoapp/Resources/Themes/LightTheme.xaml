<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand and semantic colors -->
    <Color x:Key="PrimaryColor">#FF6B47</Color>
    <Color x:Key="PrimaryLightColor">#FF825F</Color>
    <Color x:Key="PrimaryDarkColor">#E85A36</Color>
    <Color x:Key="AccentColor">#FFB199</Color>
    <Color x:Key="SuccessColor">#2B9A46</Color>
    <Color x:Key="DangerColor">#D63B31</Color>
    <Color x:Key="WarningColor">#C47E23</Color>
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#525252</Color>
    <Color x:Key="TextMuted">#767676</Color>

    <!-- Brand and status brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#20D63B31"/>
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#20FF6B47"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#E8554A"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#B83229"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFFFF"/>

    <!-- Fluent surface contract -->
    <SolidColorBrush x:Key="AppBaseSurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TitleBarSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="CommandBarSurfaceBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="StatusBarSurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogBaseSurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#FFFFFF"/>

    <!-- Strokes and neutral interaction states -->
    <SolidColorBrush x:Key="WindowStrokeBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="NeutralHoverBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="NeutralPressedBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="TitleBarPressedBrush" Color="#20000000"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#767676"/>
    <SolidColorBrush x:Key="TagBrush" Color="#F2F2F2"/>

    <!-- Selection states -->
    <SolidColorBrush x:Key="NavigationSelectedBackgroundBrush" Color="#FFEFE9"/>
    <SolidColorBrush x:Key="NavigationSelectedForegroundBrush" Color="#B83D1F"/>
    <SolidColorBrush x:Key="NavigationSelectedIndicatorBrush" Color="#FF6B47"/>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#FFEFE9"/>
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#FF6B47"/>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#B83D1F"/>

    <!-- Dialog and button roles -->
    <SolidColorBrush x:Key="DialogForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DialogSecondaryForegroundBrush" Color="#525252"/>
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#DADADA"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
