<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ToDoapp.Controls">

    <!--
        合并 Themes/Generic.xaml 自身依赖的静态资源。
        注意：WPF 通过 ThemeInfo 机制自动加载 Themes/Generic.xaml 作为 CustomControl 的默认样式，
        该字典不会合并到 App.Resources 中，因此必须自包含它直接引用的 StaticResource。
        主题 Brush 通过 DynamicResource 引用（运行时查找 Application.Resources）。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Resources/ModernColors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Resources/IconGeometries.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- CalendarPopup 默认样式（WPF CustomControl 规范：位于 Themes/Generic.xaml 由运行时自动加载） -->
    <Style TargetType="{x:Type controls:CalendarPopup}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CalendarPopup}">
                    <Grid>
                        <!-- 输入框区域：带日历图标的边框 -->
                        <Border x:Name="PART_InputBorder"
                                Height="36"
                                Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusInput}"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 日期文本显示 -->
                                <TextBlock x:Name="PART_DateText"
                                           Grid.Column="0"
                                           Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue=''}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           IsHitTestVisible="False"/>

                                <!-- 占位文字 -->
                                <TextBlock x:Name="PART_Placeholder"
                                           Grid.Column="0"
                                           Text="选择日期"
                                           Foreground="{DynamicResource PlaceholderBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           IsHitTestVisible="False"/>

                                <!-- 日历图标 -->
                                <Path Grid.Column="1"
                                      Data="{StaticResource CalendarIconGeometry}"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- 弹出日历面板：StaysOpen=True，由代码接管"点击外部关闭"逻辑，
                             避免 StaysOpen=False 内部鼠标捕获导致的"按下闪关"问题。 -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               PlacementTarget="{Binding ElementName=PART_InputBorder}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               VerticalOffset="4">

                            <Border UseLayoutRounding="True"
                                    Width="280"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusOverlay}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.35" Color="#000000"/>
                                </Border.Effect>

                                <StackPanel Margin="8">
                                    <!-- 顶部导航栏 -->
                                    <Grid Height="36" Margin="0,0,0,4">
                                        <!-- 左箭头 -->
                                        <Button x:Name="PART_PreviousButton"
                                                Width="32" Height="32"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="上一页">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            CornerRadius="{StaticResource RadiusInput}">
                                                        <Path Data="{StaticResource ChevronRightIconGeometry}"
                                                              Width="10" Height="10"
                                                              Stretch="Uniform"
                                                              Fill="{DynamicResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <ScaleTransform ScaleX="-1"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 年份/月份双按钮标题 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <!-- 年份按钮 -->
                                            <Button x:Name="PART_YearHeaderButton"
                                                    Height="32"
                                                    MinWidth="64"
                                                    Padding="8,0"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    ToolTip="选择年份">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                CornerRadius="{StaticResource RadiusInput}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                                <Path Grid.Column="1"
                                                                      Data="{StaticResource ChevronDownIconGeometry}"
                                                                      Width="7" Height="7"
                                                                      Stretch="Uniform"
                                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- 月份按钮 -->
                                            <Button x:Name="PART_MonthHeaderButton"
                                                    Height="32"
                                                    MinWidth="48"
                                                    Padding="8,0"
                                                    Margin="2,0,0,0"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    ToolTip="选择月份">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                CornerRadius="{StaticResource RadiusInput}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                                <Path Grid.Column="1"
                                                                      Data="{StaticResource ChevronDownIconGeometry}"
                                                                      Width="7" Height="7"
                                                                      Stretch="Uniform"
                                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <!-- 右箭头 -->
                                        <Button x:Name="PART_NextButton"
                                                Width="32" Height="32"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="下一页">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            CornerRadius="{StaticResource RadiusInput}">
                                                        <Path Data="{StaticResource ChevronRightIconGeometry}"
                                                              Width="10" Height="10"
                                                              Stretch="Uniform"
                                                              Fill="{DynamicResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- 清除按钮 -->
                                        <Button x:Name="PART_ClearButton"
                                                Width="24" Height="24"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,36,0"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="清除日期">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            CornerRadius="{StaticResource RadiusInput}">
                                                        <Path Data="{StaticResource CloseIconGeometry}"
                                                              Width="8" Height="8"
                                                              Stretch="Uniform"
                                                              Fill="{DynamicResource TextMutedBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- 月份视图网格 -->
                                    <Grid x:Name="PART_MonthGrid"/>

                                    <!-- 年份视图网格 -->
                                    <Grid x:Name="PART_YearGrid" Visibility="Collapsed"/>

                                    <!-- 十年视图网格 -->
                                    <Grid x:Name="PART_DecadeGrid" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 弹窗打开时边框变为主色 -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_InputBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <!-- 鼠标悬停时边框变为主色 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDropDownOpen" Value="False"/>
                                <Condition SourceName="PART_InputBorder" Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_InputBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
