<UserControl x:Class="ToDoapp.Views.Settings.Appearance.OpacitySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpacitySettingsViewModel}"
             xmlns:vm="clr-namespace:ToDoapp.ViewModels.Settings.Appearance"
             FontSize="14">
    <StackPanel Margin="20">
        <TextBlock Text="透明度设置"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>
        <TextBlock Text="分别调整小组件的背景和内容透明度。"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <TextBlock Text="背景透明度"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,10,0,10"/>
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0"
                    Minimum="0.2"
                    Maximum="1.0"
                    Value="{Binding BackgroundOpacity, Mode=TwoWay}"
                    Width="300"
                    Foreground="{DynamicResource PrimaryBrush}"
                    SmallChange="0.1"
                    LargeChange="0.1"
                    IsMoveToPointEnabled="True"
                    TickFrequency="0.1"
                    TickPlacement="BottomRight"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="60"
                       TextAlignment="Left"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="内容透明度"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,15,0,10"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0"
                    Minimum="0.2"
                    Maximum="1.0"
                    Value="{Binding ContentOpacity, Mode=TwoWay}"
                    Width="300"
                    Foreground="{DynamicResource PrimaryBrush}"
                    SmallChange="0.1"
                    LargeChange="0.1"
                    IsMoveToPointEnabled="True"
                    TickFrequency="0.1"
                    TickPlacement="BottomRight"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ContentOpacity, StringFormat={}{0:P0}}"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="60"
                       TextAlignment="Left"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</UserControl>
