<UserControl x:Class="ToDoapp.Views.Settings.General.StartupReminderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartupReminderSettingsViewModel}"
             xmlns:vm="clr-namespace:ToDoapp.ViewModels.Settings.General"
             xmlns:models="clr-namespace:ToDoapp.Models"
             FontSize="14">
    <UserControl.Resources>
        <!-- 启动弹窗项模板（无时间列） -->
        <DataTemplate x:Key="StartupReminderItemTemplate" DataType="{x:Type models:StartupReminderEntry}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Text}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>
                <Button Grid.Column="2"
                        Content="删除"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6,12,6"
                        Margin="10,0,0,0"
                        Command="{Binding DataContext.RemoveStartupReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>

        <!-- 定时弹窗项模板（含时间列） -->
        <DataTemplate x:Key="ScheduledReminderItemTemplate" DataType="{x:Type models:StartupReminderEntry}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <TextBox Grid.Column="1"
                         Width="84"
                         Text="{Binding ScheduledTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         MaxLength="5"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Text}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>
                <Button Grid.Column="3"
                        Content="删除"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6,12,6"
                        Margin="10,0,0,0"
                        Command="{Binding DataContext.RemoveScheduledReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="弹窗提示"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>
        <TextBlock Grid.Row="1"
                   Text="统一管理应用启动和每日定时弹出的提醒内容。"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Style="{StaticResource ModernTabControlStyle}">
            <!-- 启动弹窗 -->
            <TabItem Header="启动弹窗" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding StartupDescription}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding IsStartupReminderEnabled}"
                                      Style="{StaticResource ModernCheckBoxStyle}"/>
                            <TextBlock Text="{Binding StartupStatusText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="提醒内容"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,2,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StartupInputBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MinWidth="160"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     KeyDown="StartupInputBox_KeyDown"/>
                            <Button Grid.Column="1"
                                    Content="新增提醒"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="14,10,14,10"
                                    Command="{Binding AddStartupReminderCommand}"
                                    CommandParameter="{Binding ElementName=StartupInputBox, Path=Text}"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                            <ItemsControl ItemsSource="{Binding StartupReminderItems}"
                                          ItemTemplate="{StaticResource StartupReminderItemTemplate}"/>
                        </ScrollViewer>
                        <TextBlock Text="{Binding StartupEmptyStateText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StartupReminderItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding StartupHintText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 定时弹窗 -->
            <TabItem Header="定时弹窗" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding ScheduledDescription}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding IsScheduledReminderEnabled}"
                                      Style="{StaticResource ModernCheckBoxStyle}"/>
                            <TextBlock Text="{Binding ScheduledStatusText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="提醒内容"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,2,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Width="84"
                                     Text="{Binding ScheduledTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="5"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"/>
                            <TextBox x:Name="ScheduledInputBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MinWidth="160"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     KeyDown="ScheduledInputBox_KeyDown"/>
                            <Button Grid.Column="2"
                                    Content="新增提醒"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="14,10,14,10"
                                    Command="{Binding AddScheduledReminderCommand}"
                                    CommandParameter="{Binding ElementName=ScheduledInputBox, Path=Text}"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                            <ItemsControl ItemsSource="{Binding ScheduledReminderItems}"
                                          ItemTemplate="{StaticResource ScheduledReminderItemTemplate}"/>
                        </ScrollViewer>
                        <TextBlock Text="{Binding ScheduledEmptyStateText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScheduledReminderItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding ScheduledHintText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
