<Window x:Class="ToDoapp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoapp.Views"
        xmlns:vm="clr-namespace:ToDoapp.ViewModels"
        xmlns:settings="clr-namespace:ToDoapp.ViewModels.Settings"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="设置"
        Height="580" Width="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="14"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            CaptionHeight="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 左侧设置项的 DataTemplate -->
        <DataTemplate x:Key="SettingItemTemplate" DataType="{x:Type settings:SettingsPageViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Style="{StaticResource AppWindowFrameStyle}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Style="{StaticResource TitleBarContainerStyle}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="设置"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="16" FontWeight="SemiBold"
                              VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                           Click="CloseButton_Click"
                           Style="{StaticResource TitleBarCloseButtonStyle}"
                           VerticalAlignment="Stretch">
                        <Viewbox Width="{StaticResource DialogTitleBarIconSize}" Height="{StaticResource DialogTitleBarIconSize}">
                            <Path Data="{StaticResource CloseIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧设置项列表 -->
                <Border Grid.Column="0" Style="{StaticResource SidebarStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,12">
                            <!-- 常规设置分类 -->
                            <TextBlock Text="常规"
                                      Foreground="{DynamicResource TextMutedBrush}"
                                      FontSize="11" FontWeight="SemiBold"
                                      Margin="12,8,12,6"/>

                            <ListBox x:Name="GeneralSettingsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource NavigationItemStyle}"
                                     ItemTemplate="{StaticResource SettingItemTemplate}"
                                     ItemsSource="{Binding GeneralPages}"
                                     SelectionChanged="SettingItem_SelectionChanged"
                                     SelectionMode="Single"/>

                            <!-- 外观设置分类 -->
                            <TextBlock Text="外观"
                                      Foreground="{DynamicResource TextMutedBrush}"
                                      FontSize="11" FontWeight="SemiBold"
                                      Margin="12,16,12,6"/>

                            <ListBox x:Name="AppearanceSettingsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource NavigationItemStyle}"
                                     ItemTemplate="{StaticResource SettingItemTemplate}"
                                     ItemsSource="{Binding AppearancePages}"
                                     SelectionChanged="SettingItem_SelectionChanged"
                                     SelectionMode="Single"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 右侧设置内容区域：由 Implicit DataTemplate 自动按 ViewModel 类型选 View -->
                <Border Grid.Column="1" Style="{StaticResource ContentSurfaceStyle}">
                    <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
