<Window x:Class="ToDoapp.Views.StartupReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="开机提示"
        Width="560"
        MinWidth="520"
        MinHeight="280"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#202020" CornerRadius="10" BorderBrush="#3D3D3D" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="18" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding GreetingText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="展示你设置好的提醒内容。"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            Style="{StaticResource IconButtonStyle}"
                            Foreground="{StaticResource DangerBrush}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="BodyScrollViewer"
                          Margin="0,0,0,18"
                          MaxHeight="400"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="16"
                            Background="#282828"
                            CornerRadius="8"
                            Visibility="{Binding HasCustomReminders, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="自定义提醒"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="会根据内容自动撑开；条目较多时在这里开始滚动。"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <ScrollViewer Margin="0,12,0,0"
                                          x:Name="CustomRemindersScrollViewer"
                                          MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CustomReminders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    Padding="12"
                                                    Background="#1F1F1F"
                                                    CornerRadius="6"
                                                    BorderBrush="#333333"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Height="1"
                        Margin="0,0,0,14"
                        Background="#333333"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="0,0,16,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="320"
                               Text="仅在开机自启时显示，可在设置中关闭。"/>

                    <Button Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Content="知道了"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="AcknowledgeButton_Click"/>

                    <Button Grid.Column="2"
                            Padding="18,10"
                            Content="打开主窗口"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="OpenMainWindowButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
