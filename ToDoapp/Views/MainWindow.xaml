<Window x:Class="ToDoapp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ToDoapp.Converters"
        xmlns:widgets="clr-namespace:ToDoapp.Views"
        xmlns:controls="clr-namespace:ToDoapp.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="待办便签" Height="700" Width="420"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Topmost="False"
        ResizeMode="CanResize"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        
        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}"/>
        
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}"/>
        
        <Style TargetType="ListBox" BasedOn="{StaticResource ModernListBoxStyle}"/>
        
        <Style x:Key="WidgetStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusWindow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    
    <Border x:Name="MainBorder" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid x:Name="MainInterfaceGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="8,8,0,0" 
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="待办便签" Foreground="{DynamicResource TextPrimaryBrush}" 
                              FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="1" x:Name="SettingsButton" Width="32" Height="32"
                           Click="SettingsButton_Click" ToolTip="设置" Style="{StaticResource IconButtonStyle}"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{StaticResource TitleBarIconSize}" Height="{StaticResource TitleBarIconSize}">
                            <Path Data="{StaticResource SettingsIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    
                    <Button Grid.Column="2" x:Name="ThemeToggleButton" Width="32" Height="32" Padding="6"
                           Click="ThemeToggleButton_Click" ToolTip="切换到浅色"
                           Style="{StaticResource IconButtonStyle}"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox x:Name="ThemeToggleButtonIconBox" Width="{StaticResource ThemeDayIconSize}" Height="{StaticResource ThemeDayIconSize}">
                            <Path x:Name="ThemeToggleButtonIcon" Data="{StaticResource DayIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    
                    <Button Grid.Column="3" x:Name="WidgetModeButton" Width="32" Height="32"
                           Click="WidgetModeButton_Click" ToolTip="切换小组件模式" 
                           Style="{StaticResource IconButtonStyle}"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{StaticResource TitleBarIconSize}" Height="{StaticResource TitleBarIconSize}">
                            <Path x:Name="WidgetModeButtonIcon" Data="{StaticResource WidgetModeIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    
                    <Button Grid.Column="4" x:Name="MinimizeButton" Width="32" Height="32"
                           Click="MinimizeButton_Click" ToolTip="最小化" Style="{StaticResource IconButtonStyle}"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{StaticResource TitleBarIconSize}" Height="{StaticResource TitleBarIconSize}">
                            <Path Data="{StaticResource MinimizeIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    
                    <Button Grid.Column="5" Width="32" Height="32"
                           Click="ExitButton_Click"
                           Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource DangerBrush}"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{StaticResource TitleBarIconSize}" Height="{StaticResource TitleBarIconSize}">
                            <Path Data="{StaticResource CloseIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
            
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceLightBrush}"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox x:Name="NewTaskTextBox"
                                ToolTip="输入新的待办事项..."
                                MaxLength="200"
                                KeyDown="NewTaskTextBox_KeyDown"
                                GotFocus="NewTaskTextBox_GotFocus"
                                LostFocus="NewTaskTextBox_LostFocus"
                                TextChanged="NewTaskTextBox_TextChanged"
                                Style="{StaticResource ModernTextBoxStyle}"/>
                        <TextBlock x:Name="PlaceholderText" Text="添加新的待办事项..." 
                                  Foreground="{DynamicResource PlaceholderBrush}" FontSize="14" 
                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                    </Grid>
                    
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="截止日期:" Foreground="{DynamicResource TextPrimaryBrush}" 
                                  FontSize="13" VerticalAlignment="Center"/>
                        
                        <controls:CalendarPopup Grid.Column="1" x:Name="DueDatePicker"
                                                 SelectedDateChanged="DueDatePicker_SelectedDateChanged"
                                                 MinWidth="160"
                                                 Margin="10,0,0,0"/>
                        
                        <Button Grid.Column="2" x:Name="ClearDateButton" Width="28" Height="28" 
                               Margin="6,0,0,0" ToolTip="清除日期"
                               Click="ClearDateButton_Click" 
                               Style="{StaticResource IconButtonStyle}">
                            <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                <Path Data="{StaticResource CloseIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        
                        <Button Grid.Column="4" Height="36" Width="100"
                               Click="SmartReadButton_Click" Margin="0,0,0,0"
                               ToolTip="智能添加 (AI)"
                               Style="{StaticResource ModernButtonStyle}">
                            <TextBlock Text="AI 添加" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    Padding="12,10">
                <TabControl x:Name="TaskTabs" Background="Transparent" BorderThickness="0" 
                          TabStripPlacement="Top" Style="{StaticResource ModernTabControlStyle}"
                          SelectionChanged="TaskTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItemStyle}"/>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                    </TabControl.Resources>
                    
                    <TabItem Header="待办">
                        <ListBox x:Name="TasksListBox" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 KeyDown="TasksListBox_KeyDown"
                                 MouseDoubleClick="TasksListBox_MouseDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                    <MenuItem Header="修改" Click="EditTask_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                                    <MenuItem Header="复制" Click="CopyTask_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="border" Background="Transparent" 
                                                        CornerRadius="4" Margin="0,2" Padding="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" 
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="TaskCheckBox_Checked" Unchecked="TaskCheckBox_Checked"
                                                 Style="{StaticResource ModernCheckBoxStyle}"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" 
                                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                                      TextTrimming="CharacterEllipsis" 
                                                      TextWrapping="NoWrap"
                                                      FontSize="14">
                                                <TextBlock.Width>
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBox}">
                                                        <Binding.Converter>
                                                            <converters:WidthAdjustConverter />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Width>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                      Visibility="{Binding DueDateDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource TagBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DueDateDisplay}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="2" Width="28" Height="28"
                                               Tag="{Binding}" Click="DeleteTaskButton_Click"
                                               ToolTip="删除">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                                <Path Data="{StaticResource DeleteIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    
                    <TabItem Header="已完成">
                        <ListBox x:Name="CompletedTasksListBox" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 KeyDown="TasksListBox_KeyDown"
                                 MouseDoubleClick="TasksListBox_MouseDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                    <MenuItem Header="修改" Click="EditTask_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                                    <MenuItem Header="复制" Click="CopyTask_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                                    <Separator Style="{StaticResource ModernSeparatorStyle}"/>
                                    <MenuItem Header="归档" Click="ArchiveTask_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="border" Background="Transparent" 
                                                        CornerRadius="4" Margin="0,2" Padding="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" 
                                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Checked="TaskCheckBox_Checked" Unchecked="TaskCheckBox_Checked"
                                                 Style="{StaticResource ModernCheckBoxStyle}"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" 
                                                      Foreground="{DynamicResource TextMutedBrush}" 
                                                      TextTrimming="CharacterEllipsis" 
                                                      TextWrapping="NoWrap"
                                                      TextDecorations="Strikethrough"
                                                      FontSize="14">
                                                <TextBlock.Width>
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBox}">
                                                        <Binding.Converter>
                                                            <converters:WidthAdjustConverter />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Width>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                                      Visibility="{Binding DueDateDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource TagBrush}"/>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DueDateDisplay}" FontSize="11" 
                                                              Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Border>
                                                <Border CornerRadius="3" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource TagBrush}"/>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="完成 {0:MM/dd HH:mm}">
                                                                <Binding Path="CompletedDate"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Width="28" Height="28"
                                                   Tag="{Binding}" Click="ArchiveTaskButton_Click"
                                                   ToolTip="归档">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                                    <Path Data="{StaticResource ArchiveIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Width="28" Height="28"
                                                   Tag="{Binding}" Click="DeleteTaskButton_Click"
                                                   ToolTip="删除">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                                    <Path Data="{StaticResource DeleteIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    
                    <TabItem Header="归档">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="已归档的任务" x:Name="ArchivedHeaderText"
                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                              VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="全部恢复" Height="28" Padding="12,0"
                                           Click="UnarchiveAllButton_Click" FontSize="12"/>
                                </Grid>
                            </Border>

                            <TreeView x:Name="ArchivedGroupsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.Resources>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Style>
                                </TreeView.Resources>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                                      VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ToggleButton Width="28" Height="28"
                                                       Tag="{Binding}"
                                                       Click="YearExpandButton_Click"
                                                       ToolTip="展开到周">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" CornerRadius="4">
                                                                            <Viewbox Width="{StaticResource ChevronIconSize}" Height="{StaticResource ChevronIconSize}">
                                                                                <Path x:Name="Icon"
                                                                                      Data="{StaticResource ChevronRightIconGeometry}"
                                                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                                                      Stretch="Uniform"/>
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource ChevronDownIconGeometry}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Grid>

                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <Grid MinHeight="32">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                                              VerticalAlignment="Center"/>
                                                </Grid>

                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <HierarchicalDataTemplate ItemsSource="{Binding Tasks}">
                                                        <Grid MinHeight="32">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                                      VerticalAlignment="Center"/>
                                                        </Grid>

                                                        <HierarchicalDataTemplate.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid MinHeight="44">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                  TextTrimming="CharacterEllipsis"
                                                                                  TextWrapping="NoWrap"
                                                                                  FontSize="13"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                                                                  Background="{DynamicResource TagBrush}">
                                                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                                                                                    <TextBlock.Text>
                                                                                        <MultiBinding StringFormat="完成 {0:MM/dd HH:mm}">
                                                                                            <Binding Path="CompletedDate"/>
                                                                                        </MultiBinding>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Button Width="28" Height="28"
                                                                               Tag="{Binding}" Click="UnarchiveTaskButton_Click"
                                                                               ToolTip="恢复">
                                                                            <Button.Style>
                                                                                <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                                                                <Path Data="{StaticResource RestoreIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                            </Viewbox>
                                                                        </Button>
                                                                        <Button Width="28" Height="28"
                                                                               Tag="{Binding}" Click="PermanentDeleteTaskButton_Click"
                                                                               ToolTip="永久删除">
                                                                            <Button.Style>
                                                                                <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                                                                <Path Data="{StaticResource DeleteIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                            </Viewbox>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </HierarchicalDataTemplate.ItemTemplate>
                                                    </HierarchicalDataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <StackPanel>
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="4" Margin="0,1" Padding="4,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                            ClickMode="Press" Focusable="False"
                                                                            Width="20" Height="20" Margin="0,0,4,0">
                                                                    <ToggleButton.Style>
                                                                        <Style TargetType="ToggleButton">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                                        <Border Background="Transparent">
                                                                                            <Viewbox Width="{StaticResource ChevronIconSize}" Height="{StaticResource ChevronIconSize}">
                                                                                                <Path x:Name="ExpanderIcon"
                                                                                                      Data="{StaticResource ChevronRightIconGeometry}"
                                                                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                                                                      Stretch="Uniform"/>
                                                                                            </Viewbox>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="ExpanderIcon" Property="Data" Value="{StaticResource ChevronDownIconGeometry}"/>
                                                            </Trigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="ExpanderIcon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ToggleButton.Style>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                                                  ContentSource="Header"
                                                                                  HorizontalAlignment="Stretch"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                        <Trigger Property="IsExpanded" Value="False">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="True"/>
                                                                <Condition Property="HasItems" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
                                                        </MultiTrigger>
                                                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="垃圾箱">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="任务将在7天后自动永久删除" 
                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" 
                                              VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="清空垃圾箱" Height="28" Padding="12,0"
                                           Click="EmptyTrashButton_Click" FontSize="12"/>
                                </Grid>
                            </Border>
                            
                            <ListBox x:Name="DeletedTasksListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                        <MenuItem Header="恢复" Click="RestoreTask_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                                        <Separator Style="{StaticResource ModernSeparatorStyle}"/>
                                        <MenuItem Header="永久删除" Click="PermanentDeleteTask_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="border" Background="Transparent" 
                                                            CornerRadius="4" Margin="0,2" Padding="4">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" 
                                                          Foreground="{DynamicResource TextMutedBrush}" 
                                                          TextTrimming="CharacterEllipsis" 
                                                          TextWrapping="NoWrap"
                                                          FontSize="14">
                                                    <TextBlock.Width>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBox}">
                                                            <Binding.Converter>
                                                                <converters:WidthAdjustConverter />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </TextBlock.Width>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                                          Background="{DynamicResource DangerSubtleBrush}">
                                                        <TextBlock Text="{Binding DeleteTimeDisplay}" FontSize="11" 
                                                                  Foreground="{DynamicResource DangerBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Width="28" Height="28"
                                                       Tag="{Binding}" Click="RestoreTaskButton_Click"
                                                       ToolTip="恢复">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                                        <Path Data="{StaticResource RestoreIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button Width="28" Height="28"
                                                       Tag="{Binding}" Click="PermanentDeleteTaskButton_Click"
                                                       ToolTip="永久删除">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Viewbox Width="{StaticResource ContentActionIconSize}" Height="{StaticResource ContentActionIconSize}">
                                                        <Path Data="{StaticResource DeleteIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
            
            <Border Grid.Row="3" Background="{DynamicResource TitleBarBrush}" CornerRadius="0,0,8,8" Padding="16,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.BorderThickness>
                    <Thickness>0,1,0,0</Thickness>
                </Border.BorderThickness>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="300">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusTextBlock" Text="就绪" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                  MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TaskCountTextBlock" Text="" Foreground="{DynamicResource TextSecondaryBrush}" 
                                  FontSize="12" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="退出" Width="70" Height="32" 
                           Click="ExitButton_Click" FontSize="12"
                           Padding="8,0"/>
                </Grid>
            </Border>
            </Grid>
            
            <Grid x:Name="WidgetInterfaceGrid" Visibility="Collapsed">
                <widgets:WidgetView x:Name="WidgetView"/>
            </Grid>
        </Grid>
    </Border>
</Window>

